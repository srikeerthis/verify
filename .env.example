# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Real environment variables override .env, so Render's dashboard config wins.

# --- core ---
PUBLIC_BASE_URL=http://localhost:8000
DB_PATH=

# --- linq (app/notify.py) ---
# Linq is SMS: contacts are phone numbers in E.164 (+15551234567), not emails.
# Token from dashboard.linqapp.com/api-tooling → API → Overview.
# Leave LINQ_API_KEY empty to run the pipeline with notifications disabled.
# Every event then logs as `skipped` and nothing breaks.
LINQ_API_KEY=
LINQ_API_BASE=https://api.linqapp.com/api/partner/v3
# Optional sender line, also E.164. Empty lets Linq choose.
LINQ_SENDER_ID=
# whsec_... from the webhook subscription. Required to accept candidate replies.
LINQ_WEBHOOK_SECRET=

# --- test handsets (scripts only, never read by the app) ---
# The two numbers a live test texts. Both may be the same handset — you then get
# the recruiter and candidate messages on one phone, which still proves the loop.
TEST_COMPANY_PHONE=
TEST_CANDIDATE_PHONE=

# --- agent (app/agent.py, app/tools.py, app/workflow.py) ---
# The coordination agent: composes Linq texts from prompts + package facts,
# and answers inbound replies from either side. Any Anthropic-compatible
# /v1/messages gateway works. Leave ANTHROPIC_API_KEY empty and every message
# falls back to the static templates in templates/notify — the whole loop
# still demos.
#
# Pioneer (https://agent.pioneer.ai) — keys start with pio_sk_:
#   ANTHROPIC_API_URL=https://api.pioneer.ai/v1/messages
#   AGENT_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# DeepSeek-V4-Flash: $0.14/M in, $0.28/M out — strong tool use, 1M ctx.
# Use the dated -0731 snapshot; the undated alias 500s upstream (2026-08-15).
# Alternates on Pioneer: gpt-4.1-nano ($0.10/M), Qwen3-235B-Instruct ($1.20/M).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_VERSION=2023-06-01
# Tool-use loop knobs. Defaults are fine for the demo.
AGENT_MAX_TOKENS=1024
AGENT_MAX_TURNS=6
AGENT_HISTORY_TURNS=10

# --- terac (app/escalate.py) ---
TERAC_API_KEY=
TERAC_MCP_URL=
# Optional: reuse an existing Terac project instead of creating one on first
# escalation.
TERAC_PROJECT_ID=

# --- scan (app/static_scan.py LLM review, app/agent.py judge) ---
# Deliberately separate from ANTHROPIC_API_KEY/AGENT_MODEL above (Vera, the
# SMS coordinator). The scan judge and LLM code review use OpenAI instead.
OPENAI_API_KEY=
SCAN_MODEL=gpt-4o-mini

# --- superserve (app/sandbox_scan.py) ---
SUPERSERVE_API_KEY=

# --- stripe (app/pay.py) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# --- webapp handoff (app/handoff.py) ---
# The Verify web app that serves signed packages with human-friendly pages.
# publish() posts each delivered package there and stores the returned links
# on the package row; Linq texts then carry them. Leave WEBAPP_API_KEY empty
# to run with the handoff disabled — texts fall back to the report link.
WEBAPP_BASE_URL=http://localhost:3000
WEBAPP_API_KEY=
WEBAPP_SIGNER_EMAIL=agents@verify.app
