# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Real environment variables override .env, so Render's dashboard config wins.

# --- core ---
PUBLIC_BASE_URL=http://localhost:8000
DB_PATH=

# --- linq (app/notify.py) ---
# Leave LINQ_API_KEY empty to run the pipeline with notifications disabled.
# Every event then logs as `skipped` and nothing breaks.
LINQ_API_KEY=
LINQ_API_BASE=
LINQ_SENDER_ID=

# --- agent (app/agent.py) ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

# --- terac (app/escalate.py) ---
TERAC_API_KEY=
TERAC_MCP_URL=

# --- stripe (app/pay.py) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
