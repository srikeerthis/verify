# Port to listen on
PORT=3000

# Max upload size in megabytes
MAX_UPLOAD_MB=100

# Set to 1 to also return OTP codes in API responses (local testing only!)
# DEV_MODE=1

# Server-to-server intake for the pipeline (app/handoff.py in this repo).
# When set, POST /api/integration/packages accepts an X-API-Key header and
# signs packages without the email-OTP flow. start.sh wires this to the
# pipeline's WEBAPP_API_KEY automatically.
# INTEGRATION_API_KEY=change-me

# Real email delivery via nodemailer. Without this, codes are printed to the server console.
# SMTP_URL=smtps://user:pass@smtp.example.com
# MAIL_FROM=Verify <no-reply@example.com>
